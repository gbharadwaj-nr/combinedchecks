<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Daily Health Check - {{ client_name }}</title>
<style>
  body { font-family: 'Segoe UI', Arial, sans-serif; background:#f4f6f8; color:#1f2933; margin:0; padding:0; }
  .container { max-width: 1000px; margin: 0 auto; padding: 24px; }
  h1 { font-size: 22px; margin-bottom: 4px; }
  .subtitle { color:#52606d; margin-top:0; margin-bottom:24px; font-size:13px; }
  .overall-banner { padding:14px 20px; border-radius:6px; font-size:18px; font-weight:600; margin-bottom:24px; color:#fff; }
  .overall-HEALTHY { background:#1f9d55; }
  .overall-WARNING { background:#d97706; }
  .overall-CRITICAL { background:#c0362c; }
  table { width:100%; border-collapse: collapse; margin-bottom: 28px; background:#fff; }
  th, td { text-align:left; padding:8px 12px; border-bottom:1px solid #e2e8f0; font-size:13px; vertical-align:top; }
  th { background:#eef2f7; font-weight:600; }
  section h2 { font-size:17px; border-bottom:2px solid #cbd5e1; padding-bottom:6px; margin-top:36px; }
  section h3 { font-size:14px; margin-bottom:4px; margin-top:20px; }
  .badge { display:inline-block; padding:3px 10px; border-radius:10px; font-size:12px; font-weight:600; color:#fff; }
  .badge-HEALTHY, .badge-COMPLETED, .badge-AVAILABLE { background:#1f9d55; }
  .badge-WARNING, .badge-NO_DATA { background:#d97706; }
  .badge-CRITICAL, .badge-FAIL, .badge-ERROR { background:#c0362c; }
  .badge-NOT_PRESENT, .badge-NOT_CONFIGURED { background:#6b7280; }
  .evidence-list { margin:4px 0 0 0; padding-left:18px; font-size:12px; color:#374151; }
  .summary-text { font-size:12px; color:#52606d; margin: 2px 0 0 0; }
  footer { font-size:11px; color:#94a3b8; margin-top:40px; text-align:center; }
</style>
</head>
<body>
<div class="container">
  <h1>Daily Health Check &mdash; {{ client_name }}</h1>
  <p class="subtitle">Run started: {{ run_started_at }} UTC &nbsp;|&nbsp; Report generated: {{ generated_at }}</p>

  <div class="overall-banner overall-{{ overall_status }}">Overall Status: {{ overall_status }}</div>

  <section>
    <h2>1. Overall Health Summary</h2>
    <table>
      <tr><th>Check</th><th>Status</th><th>Summary</th></tr>
      {% for r in results %}
      <tr>
        <td>{{ r.title }}</td>
        <td><span class="badge badge-{{ r.status.name }}">{{ r.status.value }}</span></td>
        <td>{{ r.summary }}</td>
      </tr>
      {% endfor %}
    </table>
  </section>

  <section>
    <h2>2. Infrastructure Health</h2>
    {% for r in categories.infrastructure %}
    <h3>{{ r.title }} &mdash; <span class="badge badge-{{ r.status.name }}">{{ r.status.value }}</span></h3>
    <p class="summary-text">{{ r.summary }}</p>
    {% if r.evidence %}
    <ul class="evidence-list">
      {% for e in r.evidence %}<li><strong>{{ e.label }}:</strong> {{ e.value }}</li>{% endfor %}
    </ul>
    {% endif %}
    {% endfor %}
  </section>

  <section>
    <h2>3. Application Health</h2>
    {% for r in categories.application %}
    <h3>{{ r.title }} &mdash; <span class="badge badge-{{ r.status.name }}">{{ r.status.value }}</span></h3>
    <p class="summary-text">{{ r.summary }}</p>
    {% if r.evidence %}
    <ul class="evidence-list">
      {% for e in r.evidence %}<li><strong>{{ e.label }}:</strong> {{ e.value }}</li>{% endfor %}
    </ul>
    {% endif %}
    {% endfor %}
  </section>

  <section>
    <h2>4. Batch / Business Process Health</h2>
    {% for r in categories.batch %}
    <h3>{{ r.title }} &mdash; <span class="badge badge-{{ r.status.name }}">{{ r.status.value }}</span></h3>
    <p class="summary-text">{{ r.summary }}</p>
    {% if r.evidence %}
    <ul class="evidence-list">
      {% for e in r.evidence %}<li><strong>{{ e.label }}:</strong> {{ e.value }}</li>{% endfor %}
    </ul>
    {% endif %}
    {% endfor %}
  </section>

  <section>
    <h2>5. Evidence &amp; Errors</h2>
    <p class="summary-text">Detailed evidence supporting each check result is listed above, next to the relevant check. Any check that raised an unexpected error is listed below for follow-up.</p>
    <table>
      <tr><th>Check</th><th>Timestamp (UTC)</th><th>Error</th></tr>
      {% for r in results if r.error %}
      <tr><td>{{ r.title }}</td><td>{{ r.timestamp }}</td><td>{{ r.error }}</td></tr>
      {% endfor %}
    </table>
  </section>

  <footer>Generated automatically by DailyChecksFramework &mdash; SingleClientChecks. For SRE / Management review and daily audit evidence.</footer>
</div>
</body>
</html>
